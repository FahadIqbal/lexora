### Lexora public env (Expo)
### Copy to ".env" and fill values.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI Tutor
# Production live AI should use a backend or Supabase Edge Function proxy.
EXPO_PUBLIC_AI_TUTOR_PROXY_URL=

# Development-only direct Anthropic key. Do not ship client-side keys in production.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# RevenueCat (requires custom dev client / native build)
EXPO_PUBLIC_REVENUECAT_API_KEY=
